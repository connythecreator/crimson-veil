	(text "PROJECT CRIMSON - PARTS-CONSTRAINED AFE"
		(exclude_from_sim no)
		(at 30 18 0)
		(effects
			(font
				(size 2.5 2.5)
			)
			(justify left)
		)
		(uuid "0ccda42b-c5f0-4111-a8a5-4602d012f306")
	)
	(text "U1/R1/R2 sit on '+5V' in the old sheet; U4/U5/U8 sat on '5V'. This sheet uses one +5V rail."
		(exclude_from_sim no)
		(at 30 354 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "139ec27b-9590-4923-b5f3-f26f3c44fed2")
	)
	(text "RV1 (50k) is the AD620 gain resistor: G = 1 + 49.4k/RG, about 2 at 50k, about 11 at 4.95k. No 10k is spare."
		(exclude_from_sim no)
		(at 30 375 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "2b3df6b7-e071-492a-bb7c-d53b10b8cd7b")
	)
	(text "Tetrapolar: Drive+/- go to the drive mux, Sense+/- to the sense mux. AD620 inputs must never share a drive electrode."
		(exclude_from_sim no)
		(at 30 389 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "40afa127-c36a-4410-be64-83148b765c7a")
	)
	(text "Input HPF C17 + R17 (10k) removes the AD5933 VOUT bias; AD620 REF sits at the buffered 2.500 V from U6A."
		(exclude_from_sim no)
		(at 30 347 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "4687b8a5-4771-45f6-99f7-bf72c243052c")
	)
	(text "RL1 (external load/phantom) is not fitted on the AFE board."
		(exclude_from_sim no)
		(at 30 361 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "4da77ea4-c24e-4635-b5da-fe11a4f6439f")
	)
	(text "AD5933 at 5 V, 2000 mV p-p range -> 3.00 V p-p excitation; simulated drive current 0.626 mA p-p into a body load."
		(exclude_from_sim no)
		(at 30 340 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "57a2bfa3-d08b-4e1c-86a0-f89c9211f412")
	)
	(text "MCLK (U1.8) and LV/OSC (U8.6/7) are left open, as in the existing design."
		(exclude_from_sim no)
		(at 30 368 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "5e72d863-e240-4196-b671-c079f3aa2aea")
	)
	(text "R19 (10k, Drive+ to Earth) is the sense DC return; C2/C3 would otherwise leave the body network floating at DC."
		(exclude_from_sim no)
		(at 30 396 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "8ab416b7-50f1-4511-b39a-4116552c214c")
	)
	(text "0.6 mA build, fully wired. R8/R16 and R13/R18 are 2 x 10k in parallel (5k); RV1 is the AD620 RG trimmer."
		(exclude_from_sim no)
		(at 30 24 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left)
		)
		(uuid "b6875370-917d-4132-8dc5-611ea5a8ac9e")
	)
