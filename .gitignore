# Python virtual environments
.venv/
venv/

# Python bytecode / caches
__pycache__/
*.py[cod]
*.egg-info/

# Runtime scan output (temp PNGs written by the pipeline)
crimson_veil/

# Generated pyEIT diagnostic images (so they don't enter merge)
tests/pyeit_outputs/*.png

# Tool caches
.pytest_cache/
.ruff_cache/

# Rust build artifacts
kiosk-rs/target/

# Editor / OS noise
.DS_Store
.idea/
.vscode/

# Local-only research notes (kept on disk, not published)
docs/

# KiCad local state and generated simulation output
bleed/.history/
*.lck
*.kicad_prl

# Agent / Claude Code worktrees and local config
.claude/

# Downloaded 3D model packs / vendor snapshots (not authored CAD)
3Dmodels/**/*.snapshot.*/
3Dmodels/base/3mm-led/

# Video generation assets and outputs
3Dmodels/case/marketing/
3Dmodels/case/trailer/
3Dmodels/case/trailer.sh
3Dmodels/case/trailer.ass
*.mp4
*.ass
*.blend

# Scratch / backup copies
*.bak
*.bak[0-9]*

# Marketing decks, slides, promo renders, and generator scripts (local-only)
marketing/

# Root-level presentation/report deliverables
/*.pptx
/*.potx
/*.docx
/*.pdf

# Loose top-level photos/brand exports
/imagdaadade.jpg
/CrimsonVeil-Cybercore-2-in-5.png
/CrimsonVeil-Cybercore-2-in-5.svg

# UI screenshots
screenshots/

# Generated pyEIT reconstruction figures
software/reconstruction/figures/

# Whole-device assembly generated outputs (keep scripts/README trackable)
3Dmodels/assembly/parts/
3Dmodels/assembly/preview/
3Dmodels/assembly/belt-anim/
3Dmodels/assembly/pi-stack-anim/
3Dmodels/assembly/*.blend1
3Dmodels/assembly/*.glb
